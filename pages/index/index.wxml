<view class="page">
  <!-- 顶部 Hero 区（品牌 + 标题 + 图标） -->
  <view class="hero-card">
    <view class="hero-sheen"></view>

    <!-- 左列：文本区 -->
    <view class="hero-content hero-text">
      <view class="hero-header">
        <view class="hero-brand-block">
          <text class="brand-main">HeartByte</text>
          <view class="brand-split"></view>
          <text class="brand-author">by W.DW</text>
        </view>
      </view>

      <view class="hero-body">
        <view class="hero-textual">
          <view class="hero-title one-line">心跳节律预测计算器</view>
          <view class="hero-subtitle">{{heroSubtitle}}</view>
        </view>
      </view>
    </view>

    <!-- 右列：图标区（不遮挡标题） -->
    <view class="hero-icon-wrap">
      <view class="hero-glow"></view>
      <image class="hero-icon" src="{{heroIcon}}" mode="aspectFit" style="transform: scale({{pulseScale}});"></image>
    </view>
  </view>

  <!-- 输入卡片 -->
  <view class="card input-card">
    <view class="input-header">
      <view class="input-title-stack">
        <text class="section-title input-title-text">患者输入</text>
      </view>
    </view>

    <text class="section-desc input-desc">填写下方字段并点击预测按钮以生成机械时相窗口。</text>

    <view class="input-grid">
      <!-- 性别 -->
      <view class="field">
        <view class="field-header">
          <text class="field-name">性别</text>
          <text class="field-hint">Sex</text>
        </view>
        <picker class="picker" mode="selector" range="{{sexOptions}}" range-key="label" value="{{sexIndex}}" bindchange="handleSexChange">
          <view class="picker-display">
            <text class="picker-value-text">{{sexOptions[sexIndex].label}}</text>
            <view class="picker-arrow"></view>
          </view>
        </picker>
      </view>

      <!-- 年龄 -->
      <view class="field">
        <view class="field-header">
          <text class="field-name">年龄</text>
          <text class="field-hint">Years</text>
        </view>
        <view class="field-control">
          <input class="input" type="number" value="{{age}}" placeholder="40" data-field="age" bindinput="handleInput" />
          <text class="field-unit">岁</text>
        </view>
      </view>

      <!-- HRmax -->
      <view class="field">
        <view class="field-header">
          <text class="field-name">最大心率</text>
          <text class="field-hint">HRmax</text>
        </view>
        <view class="field-control">
          <input class="input" type="number" value="{{hrMax}}" placeholder="100" data-field="hrMax" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>

      <!-- HRmin -->
      <view class="field">
        <view class="field-header">
          <text class="field-name">最小心率</text>
          <text class="field-hint">HRmin</text>
        </view>
        <view class="field-control">
          <input class="input" type="number" value="{{hrMin}}" placeholder="80" data-field="hrMin" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>

      <!-- HRavg (optional) -->
      <view class="field">
        <view class="field-header">
          <text class="field-name">平均心率</text>
          <text class="field-hint optional">Optional</text>
        </view>
        <view class="field-control">
          <input class="input" type="number" value="{{hrAvg}}" placeholder="可选" data-field="hrAvg" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>
    </view>

    <view class="input-actions">
      <button class="primary-btn" bindtap="handlePredict">预测</button>
      <text class="form-hint">所有时间均以毫秒表示。</text>
    </view>
  </view>

  <!-- 结果区 -->
  <block wx:if="{{results}}">
    <!-- 重叠 + 时间轴 融合卡片 -->
    <view class="card timeline-card">
      <view class="timeline-heading">
        <view class="timeline-title">
          <text class="section-title">机械相位预测结果</text>
          <text class="timeline-subtitle">IVCT · LVET · IVRT 随心率绘制，并展示关键机械相位重叠区间。</text>
        </view>
        <view class="timeline-overlap-summary" wx:if="{{results.overlapSummary}}">
          <view class="overlap-chip overlap-{{item.tone}}" wx:for="{{results.overlapSummary}}" wx:key="label">
            <text class="overlap-chip-label">{{item.label}}</text>
            <text class="overlap-chip-value">{{item.value}}</text>
          </view>
        </view>
      </view>

      <scroll-view scroll-x="true" class="timeline-scroll" enable-flex="true">
        <view class="timeline-chart">
          <canvas
            class="timeline-canvas"
            id="timelineCanvas"
            canvas-id="timelineCanvas"
            style="width: {{canvasDisplayWidth}}px; height: {{canvasHeight}}px;"
            width="{{canvasPixelWidth}}"
            height="{{canvasPixelHeight}}"
          ></canvas>
        </view>
      </scroll-view>

      <text class="overlap-description">{{results.overlapSection.description}}</text>
      <text class="timeline-note">提示：结果仅作研究/教学参考，临床决策需结合实测。</text>
      <button class="timeline-export-btn" bindtap="handleExport">导出图表</button>
    </view>

    <!-- HR 卡片 -->
    <block wx:for="{{results.hrSections}}" wx:key="key" wx:for-item="section">
      <view class="card metric-card">
        <view class="card-header">
          <text class="section-title">{{section.title}}</text>
          <view class="soft-pill" style="color: {{section.color}}; background: {{section.bgColor}};">{{section.bpmLabel}}</view>
        </view>
        <view class="kv-list">
          <view class="kv-row" wx:for="{{section.items}}" wx:key="label" wx:for-item="row">
            <text class="kv-label">{{row.label}}</text>
            <text class="kv-value">{{row.value}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 术语说明（可折叠） -->
    <view class="card glossary-card">
      <view class="glossary-header" bindtap="toggleGlossary">
        <text class="section-title">术语速览</text>
        <text class="glossary-toggle">{{glossaryOpen ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{glossaryOpen}}">
        <view class="glossary-row" wx:for="{{glossary}}" wx:key="term">
          <text class="glossary-term">{{item.term}}</text>
          <text class="glossary-desc">{{item.description}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
