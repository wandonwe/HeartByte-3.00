<view class="page">
  <view class="hero-card">
    <view class="hero-sheen"></view>
    <view class="hero-content">
      <view class="hero-header">
        <view class="hero-brand-block">
          <text class="brand-main">HeartByte</text>
          <view class="brand-split"></view>
          <text class="brand-author">by W.DW</text>
        </view>
      </view>

      <view class="hero-body">
        <view class="hero-textual">
          <text class="hero-title">心跳节律预测计算器</text>
          <text class="hero-subtitle">Calculations based on regression equations reported by Schmidt et al. (Clin Res Cardiol, 2023).</text>
        </view>
        <view class="hero-icon-wrap">
          <view class="hero-glow"></view>
          <image class="hero-icon" src="{{heroIcon}}" mode="aspectFit"></image>
        </view>
      </view>
    </view>
  </view>

  <view class="card input-card">
    <view class="input-header">
      <view class="input-title-stack">
        <text class="input-pill">步骤 1</text>
        <text class="section-title input-title-text">患者输入</text>
      </view>
      <view class="input-badge">
        <view class="badge-dot"></view>
        <text class="badge-text">IVCT · LVET · IVRT</text>
      </view>
    </view>

    <text class="section-desc input-desc">填写下方字段并点击预测按钮以生成机械时相窗口。</text>

    <view class="input-grid">
      <view class="field">
        <view class="field-header">
          <text class="field-name">性别</text>
          <text class="field-hint">Sex</text>
        </view>
        <picker mode="selector" range="{{sexOptions}}" range-key="label" value="{{sexIndex}}" bindchange="handleSexChange" class="picker">
          <view class="picker-display">
            <text class="picker-value-text">{{sexOptions[sexIndex].label}}</text>
            <view class="picker-arrow"></view>
          </view>
        </picker>
      </view>

      <view class="field">
        <view class="field-header">
          <text class="field-name">年龄</text>
          <text class="field-hint">Years</text>
        </view>
        <view class="field-control">
          <input type="number" class="input" value="{{age}}" placeholder="40" data-field="age" bindinput="handleInput" />
          <text class="field-unit">岁</text>
        </view>
      </view>

      <view class="field">
        <view class="field-header">
          <text class="field-name">最大心率</text>
          <text class="field-hint">HRmax</text>
        </view>
        <view class="field-control">
          <input type="number" class="input" value="{{hrMax}}" placeholder="100" data-field="hrMax" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>

      <view class="field">
        <view class="field-header">
          <text class="field-name">最小心率</text>
          <text class="field-hint">HRmin</text>
        </view>
        <view class="field-control">
          <input type="number" class="input" value="{{hrMin}}" placeholder="80" data-field="hrMin" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>

      <view class="field">
        <view class="field-header">
          <text class="field-name">平均心率</text>
          <text class="field-hint optional">Optional</text>
        </view>
        <view class="field-control">
          <input type="number" class="input" value="{{hrAvg}}" placeholder="可选" data-field="hrAvg" bindinput="handleInput" />
          <text class="field-unit">bpm</text>
        </view>
      </view>
    </view>

    <view class="input-actions">
      <button class="primary-btn" bindtap="handlePredict">预测</button>
      <text class="form-hint">所有时间均以毫秒表示。</text>
    </view>
  </view>

  <block wx:if="{{results}}">
    <view class="card overlap-card">
      <view class="card-header">
        <text class="section-title">{{results.overlapSection.title}}</text>
        <view class="soft-pill" style="color: {{results.overlapSection.pill.color}}; background: {{results.overlapSection.pill.bgColor}};">{{results.overlapSection.pill.label}}</view>
      </view>
      <view class="kv-list">
        <view class="kv-row" wx:for="{{results.overlapSection.items}}" wx:key="label">
          <text class="kv-label">{{item.label}}</text>
          <text class="kv-value">{{item.value}}</text>
        </view>
      </view>
      <text class="section-desc">{{results.overlapSection.description}}</text>
    </view>

    <block wx:for="{{results.hrSections}}" wx:key="key" wx:for-item="section">
      <view class="card metric-card">
        <view class="card-header">
          <text class="section-title">{{section.title}}</text>
          <view class="soft-pill" style="color: {{section.color}}; background: {{section.bgColor}};">{{section.bpmLabel}}</view>
        </view>
        <view class="kv-list">
          <view class="kv-row" wx:for="{{section.items}}" wx:key="label" wx:for-item="row">
            <text class="kv-label">{{row.label}}</text>
            <text class="kv-value">{{row.value}}</text>
          </view>
        </view>
      </view>
    </block>

    <view class="card timeline-card">
      <view class="timeline-top">
        <view class="timeline-title">
          <text class="section-title">R 波对齐时间轴</text>
          <text class="timeline-subtitle">IVCT · LVET · IVRT raw durations plotted per心率.</text>
        </view>
        <view class="timeline-chip">ECG aligned</view>
      </view>

      <view class="timeline-rates" wx:if="{{results.timelineMeta && results.timelineMeta.length}}">
        <view class="rate-card tone-{{item.tone}}" wx:for="{{results.timelineMeta}}" wx:key="key">
          <text class="rate-label">{{item.label}}</text>
          <text class="rate-value">{{item.value}}</text>
        </view>
      </view>

      <view class="timeline-legend">
        <view class="legend-item">
          <view class="legend-swatch phase-ivct"></view>
          <text>IVCT</text>
        </view>
        <view class="legend-item">
          <view class="legend-swatch phase-lvet"></view>
          <text>LVET</text>
        </view>
        <view class="legend-item">
          <view class="legend-swatch phase-ivrt"></view>
          <text>IVRT</text>
        </view>
        <view class="legend-item">
          <view class="legend-swatch phase-overlap"></view>
          <text>重叠窗口</text>
        </view>
      </view>

      <view class="timeline-chart">
        <canvas
          canvas-id="timelineCanvas"
          id="timelineCanvas"
          class="timeline-canvas"
          style="width: {{canvasDisplayWidth}}px; height: {{canvasHeight}}px;"
          width="{{canvasPixelWidth}}"
          height="{{canvasPixelHeight}}"
        ></canvas>
      </view>

      <view class="timeline-overlap-cards" wx:if="{{results.overlapSection && results.overlapSection.items}}">
        <view class="overlap-card-item" wx:for="{{results.overlapSection.items}}" wx:key="label">
          <text class="overlap-name">{{item.label}}</text>
          <text class="overlap-detail">{{item.value}}</text>
        </view>
      </view>

      <text class="timeline-note">Validate predictions with clinical measurement when decisions rely on precise timings.</text>
    </view>

    <view class="card glossary-card">
      <text class="section-title">术语速览</text>
      <view class="glossary-row" wx:for="{{glossary}}" wx:key="term">
        <text class="glossary-term">{{item.term}}</text>
        <text class="glossary-desc">{{item.description}}</text>
      </view>
    </view>
  </block>
</view>
