page {
  background: linear-gradient(180deg, #dbeafe 0%, #f1f5f9 45%, #f8fafc 100%);
  min-height: 100vh;
}

.page {
  padding: 48rpx 36rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero-card {
  background: linear-gradient(135deg, #5b8def 0%, #c4d5ff 100%);
  border-radius: 40rpx;
  padding: 44rpx;
  color: #f8fafc;
  box-shadow: 0 28rpx 64rpx rgba(59, 130, 246, 0.28);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.hero-badge {
  align-self: flex-start;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #0b1f4b;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.hero-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
}

.hero-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.hero-title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(241, 245, 249, 0.85);
  line-height: 1.6;
}

.hero-visual {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-bubble {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: linear-gradient(140deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.2));
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-wave {
  width: 110rpx;
  height: 110rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.55);
  filter: blur(0);
}

.hero-wave-alt {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: rgba(91, 141, 239, 0.65);
  bottom: 28rpx;
  right: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
  padding: 36rpx;
  box-sizing: border-box;
}

.card + .card {
  margin-top: 12rpx;
}

.input-card {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.section-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field.half {
  flex: 1;
}

.field-label {
  font-size: 26rpx;
  color: #475569;
}

.input,
.picker-display {
  width: 100%;
  border: 1rpx solid #cbd5f5;
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  color: #0f172a;
  box-sizing: border-box;
  background: #f8fbff;
}

.picker {
  width: 100%;
}

.primary-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #6366f1, #4338ca);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 26rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(99, 102, 241, 0.35);
}

.form-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-header .section-title {
  margin-bottom: 0;
}

.card-header .section-desc {
  max-width: 480rpx;
}

.summary-card .card-header,
.timeline-card .card-header {
  flex-direction: column;
  align-items: flex-start;
}

.meta-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.meta-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(99, 102, 241, 0.12);
  color: #1e293b;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(99, 102, 241, 0.08);
}

.meta-chip-label {
  color: #475569;
}

.summary-desc {
  margin-top: -6rpx;
}

.phase-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.phase-group:last-child {
  border-bottom: none;
}

.phase-group:nth-child(odd) {
  background: rgba(248, 250, 252, 0.7);
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  border-radius: 20rpx;
}

.phase-group-label {
  font-size: 26rpx;
  color: #1e293b;
  flex-shrink: 0;
  min-width: 140rpx;
}

.phase-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.phase-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.chip-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
}

.phase-chip-text {
  line-height: 1;
}

.timeline-wrapper {
  margin-top: 28rpx;
  padding: 20rpx;
  background: linear-gradient(180deg, #f1f5ff 0%, #ffffff 100%);
  border-radius: 28rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.25);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
}

.timeline-canvas {
  width: 100%;
  display: block;
}

.timeline-caption {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.soft-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.results-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.summary-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, #f8fbff 100%);
  box-shadow: 0 24rpx 56rpx rgba(59, 87, 166, 0.16);
}

.overlap-card {
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 70%);
}

.metric-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, #f8fafc 100%);
}

.timeline-card {
  background: linear-gradient(180deg, rgba(248, 251, 255, 0.95) 0%, #ffffff 100%);
}

.kv-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #475569;
}

.metric-card .kv-row:last-child {
  padding-bottom: 0;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  max-width: 70%;
}

.kv-value {
  color: #0f172a;
  font-weight: 600;
}

.metric-card {
  margin-top: 12rpx;
}

.glossary-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.glossary-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.glossary-row:first-child {
  border-top: none;
}

.glossary-term {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.glossary-desc {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

@media (min-width: 768px) {
  .phase-group-label {
    min-width: 180rpx;
  }
}
