/* ==========================================================================
   Page & Layout
   ========================================================================== */
page {
  background: linear-gradient(180deg, #dbeafe 0%, #f1f5f9 45%, #f8fafc 100%);
  min-height: 100vh;
}

.page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 48rpx 36rpx 80rpx;
}

/* ========= Animations ========= */
.fade-in { animation: fadeInUp 320ms ease-out both; }
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   Hero (Header)
   ========================================================================== */
.hero-card {
  position: relative;
  display: flex;
  align-items: flex-start; /* 顶对齐：图标固定右上角，不遮标题 */
  gap: 24rpx;
  padding: 28rpx 36rpx 32rpx;
  color: #0f172a;
  background: linear-gradient(135deg, rgba(237, 245, 255, 0.86) 0%, rgba(196, 220, 255, 0.56) 42%, rgba(174, 205, 255, 0.38) 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  border-radius: 52rpx;
  box-shadow: 0 46rpx 120rpx rgba(35, 62, 142, 0.24);
  backdrop-filter: blur(42rpx);
  overflow: hidden;
}

.hero-sheen {
  position: absolute;
  inset: 0;
  border-radius: 52rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.55), transparent 58%),
    radial-gradient(circle at 82% 88%, rgba(113, 178, 255, 0.45), transparent 60%);
  pointer-events: none;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 14rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
  pointer-events: none;
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.hero-text { width: 100%; }

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-brand-block {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(6rpx);
  white-space: nowrap;
  overflow: hidden; /* 配合伪元素 */
}

.hero-brand-block::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 999rpx;
  padding: 2rpx; /* 边框宽度 */
  background: linear-gradient(90deg, #60a5fa, #a78bfa, #f472b6);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

.brand-main { font-size: 24rpx; font-weight: 700; color: #0b1220; }

.brand-split {
  width: 38rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #2563eb 0%, #0ea5e9 40%, #f472b6 100%);
}

.brand-author {
  font-size: 20rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #2563eb 0%, #9333ea 60%, #f472b6 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
  width: 100%;
}

.hero-textual {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
}

.hero-title { font-size: 46rpx; font-weight: 800; color: #0b1220; line-height: 1.2; }

.app-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0b1220;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.app-title.one-line {
  width: 100%;
  max-width: 100%;
  font-size: 46rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #475569;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* force two lines for EN text */
  overflow: hidden;
  word-break: break-word;
  width: 100%;
  max-width: 100%;
}

.hero-icon-wrap {
  position: relative; /* 非绝对定位，位于右列 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 160rpx; /* 固定列宽 */
  margin-left: auto;
  align-self: flex-start;
  margin-top: -8rpx;
  margin-right: -8rpx;
  /* 移除背景和边框样式 */
  background: none;
  box-shadow: none;
  backdrop-filter: none;
}

.hero-glow {
  display: none; /* 隐藏辉光效果 */
}

.hero-icon { position: relative; z-index: 1; width: 140rpx; height: 140rpx; }

/* ==========================================================================
   Card Base
   ========================================================================== */
.card {
  box-sizing: border-box;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
}

.card + .card { margin-top: 12rpx; }

.section-title { font-size: 34rpx; font-weight: 600; color: #0f172a; }
.section-desc  { font-size: 24rpx; color: #64748b; line-height: 1.6; }

/* ==========================================================================
   Inputs
   ========================================================================== */
.input,
.picker-display {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #f8fbff;
  border: 1rpx solid #cbd5f5;
  border-radius: 20rpx;
}

.picker { width: 100%; }

.input-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 44rpx 44rpx 48rpx;
  background: linear-gradient(180deg, rgba(248, 252, 255, 0.95) 0%, rgba(224, 237, 255, 0.9) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  overflow: hidden;
}

.input-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.3);
  pointer-events: none;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 24rpx;
}

.input-title-stack { display: flex; align-items: center; gap: 18rpx; }
.input-pill {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.16);
}

.input-title-text { margin-bottom: 0; }

.input-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.24);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #9333ea);
}

.badge-text { font-weight: 600; color: #1e293b; }

.input-desc { margin-top: -12rpx; color: #5b6475; }

.input-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260rpx, 1fr));
  gap: 24rpx;
}

.input-card .field {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 32rpx rgba(15, 23, 42, 0.06);
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.field-name { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.field-hint { font-size: 22rpx; color: #94a3b8; }
.field-hint.optional { color: #f97316; font-weight: 600; }

.field-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.field-control {
  position: relative; /* 为内部绝对定位的元素提供基准 */
}

.optional-placeholder {
  position: absolute;
  left: 24rpx; /* 与输入文本对齐 */
  top: 50%;
  transform: translateY(-50%);
  font-size: 30rpx;
  color: #94a3b8;
  opacity: 0.8;
  pointer-events: none; /* 允许点击穿透，聚焦到输入框 */
}

.input-card .field-control .input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 30rpx;
  color: #0f172a;
}

.field-unit {
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.input-card .picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.picker { width: 100%; }
.picker-value-text { font-size: 30rpx; color: #0f172a; }

.picker-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #64748b;
}

.input-actions { display: flex; flex-direction: column; gap: 18rpx; }

.primary-btn {
  width: 100%;
  margin-top: 12rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #4338ca);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(99, 102, 241, 0.35);
}

.input-actions .primary-btn { margin-top: 0; }

.form-hint { font-size: 22rpx; color: #6c7a92; }

/* ==========================================================================
   Results Section
   ========================================================================== */
.results-section {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.results-header { display: flex; flex-direction: column; gap: 12rpx; }

/* ==========================================================================
   Cards (Results)
   ========================================================================== */
.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-header .section-desc { max-width: 480rpx; }

.overlap-card { background: linear-gradient(180deg, #fff7ed 0%, #ffffff 70%); }
.metric-card  {
  padding: 40rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.8) 0%, rgba(248, 250, 252, 0.7) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(12rpx);
}
.metric-card .kv-list {
  margin-top: 24rpx;
}

/* Timeline */
.timeline-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 44rpx 40rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.15) 58%),
    radial-gradient(circle at 82% 88%, rgba(173, 203, 255, 0.45) 0%, rgba(173, 203, 255, 0) 64%),
    linear-gradient(140deg, rgba(233, 244, 255, 0.9) 0%, rgba(199, 222, 255, 0.6) 52%, rgba(178, 208, 255, 0.4) 100%);
  border: 1rpx solid rgba(148, 181, 232, 0.32);
  box-shadow: 0 48rpx 120rpx rgba(30, 64, 175, 0.16);
  backdrop-filter: blur(34rpx) saturate(145%);
  overflow: hidden;
}

.timeline-card::before {
  content: '';
  position: absolute;
  inset: 18rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
  pointer-events: none;
}

.timeline-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.timeline-overlap-summary {
  display: flex;
  flex: 1 1 320rpx;
  gap: 18rpx;
  position: relative;
  z-index: 1;
}

.overlap-chip {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx 26rpx;
  border-radius: 30rpx;
  background:
    linear-gradient(135deg, rgba(244, 249, 255, 0.95) 0%, rgba(213, 230, 255, 0.52) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(209, 229, 255, 0.45), 0 18rpx 40rpx rgba(30, 64, 175, 0.12);
  backdrop-filter: blur(26rpx) saturate(140%);
}

.overlap-chip.overlap-ivct {
  background:
    linear-gradient(135deg, rgba(249, 250, 255, 0.96) 0%, rgba(220, 231, 255, 0.6) 45%, rgba(191, 219, 254, 0.48) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(180, 198, 255, 0.4), 0 24rpx 48rpx rgba(37, 99, 235, 0.16);
}

.overlap-chip.overlap-ivrt {
  background:
    linear-gradient(135deg, rgba(246, 255, 252, 0.96) 0%, rgba(193, 246, 239, 0.6) 45%, rgba(165, 243, 252, 0.48) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(134, 239, 188, 0.45), 0 24rpx 48rpx rgba(13, 148, 136, 0.14);
}

.overlap-chip-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.overlap-chip-value {
  font-size: 22rpx;
  color: rgba(15, 23, 42, 0.85);
}

.overlap-chip.overlap-ivct .overlap-chip-label { color: #1d4ed8; }
.overlap-chip.overlap-ivrt .overlap-chip-label { color: #0f766e; }
.overlap-chip.overlap-ivrt .overlap-chip-value { color: rgba(4, 120, 87, 0.88); }

.timeline-scroll {
  width: 100%;
  overflow: hidden;
  border-radius: 36rpx;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.78) 0%, rgba(222, 235, 255, 0.52) 48%, rgba(193, 220, 255, 0.32) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35), 0 24rpx 60rpx rgba(15, 36, 94, 0.15);
  backdrop-filter: blur(28rpx) saturate(150%);
  position: relative;
  z-index: 1;
}

.timeline-overlap-details {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.overlap-detail-item {
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.5);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 12rpx 24rpx rgba(30, 64, 175, 0.08);
}

.overlap-detail-item .card-header {
  margin-bottom: 0;
  justify-content: center;
  gap: 12rpx;
}

.overlap-detail-item .section-title {
  font-size: 26rpx;
}

.timeline-chart {
  min-width: 720rpx;
  padding: 12rpx;
}

.timeline-canvas { width: 100%; display: block; border-radius: 24rpx; }

.overlap-description {
  font-size: 22rpx;
  color: rgba(71, 85, 105, 0.85);
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

.timeline-note {
  font-size: 22rpx;
  color: rgba(71, 85, 105, 0.85);
  line-height: 1.5;
  text-align: justify;
  position: relative;
  z-index: 1;
}

.timeline-export-btn {
  /* align-self: flex-end; */
  padding: 16rpx 42rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1d4ed8;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(198, 222, 255, 0.55) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(148, 181, 232, 0.35), 0 22rpx 48rpx rgba(37, 99, 235, 0.18);
  backdrop-filter: blur(24rpx) saturate(150%);
}
.timeline-export-btn:active {
  transform: translateY(2rpx);
  box-shadow: inset 0 0 0 1rpx rgba(148, 181, 232, 0.35), 0 16rpx 32rpx rgba(37, 99, 235, 0.15);
}


/* ==========================================================================
   Key-Value List
   ========================================================================== */
.soft-pill { padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }

/* HR Tones for soft-pill */
.soft-pill[data-tone="min"] { color: #3b82f6; background-color: rgba(59, 130, 246, 0.15); }
.soft-pill[data-tone="avg"] { color: #8b5cf6; background-color: rgba(139, 92, 246, 0.15); }
.soft-pill[data-tone="max"] { color: #c026d3; background-color: rgba(192, 38, 211, 0.15); }

.kv-list { margin-top: 12rpx; display: flex; flex-direction: column; }

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #475569;
  border-bottom: 1rpx solid #e2e8f0;
}

.kv-row:last-child { border-bottom: none; }

.kv-label { max-width: 70%; }
.kv-value { color: #0f172a; font-weight: 600; }

.metric-card .kv-row:last-child { padding-bottom: 0; }

/* ==========================================================================
   Glossary
   ========================================================================== */
.glossary-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 40rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.7) 0%, rgba(248, 250, 252, 0.6) 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(12rpx);
}


.glossary-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.glossary-row:first-child { border-top: none; }

.glossary-term {
  font-size: 28rpx;
  font-weight: 700;
  color: #1d4ed8;
  min-width: 120rpx;
}
.glossary-desc {
  flex: 1;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

/* Glossary header toggle */
.glossary-header { display: flex; align-items: center; justify-content: space-between; }
.glossary-toggle { font-size: 26rpx; color: #2563eb; }
