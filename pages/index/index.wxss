/* ==========================================================================
   Page & Layout
   ========================================================================== */
page {
  background: linear-gradient(180deg, #dbeafe 0%, #f1f5f9 45%, #f8fafc 100%);
  min-height: 100vh;
}

.page {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  padding: 48rpx 36rpx 80rpx;
}

/* ========= Animations ========= */
.fade-in { animation: fadeInUp 320ms ease-out both; }
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ==========================================================================
   Hero (Header)
   ========================================================================== */
.hero-card {
  position: relative;
  display: flex;
  align-items: flex-start; /* 顶对齐：图标固定右上角，不遮标题 */
  gap: 24rpx;
  padding: 36rpx 44rpx 40rpx;
  color: #0f172a;
  background: linear-gradient(135deg, rgba(237, 245, 255, 0.86) 0%, rgba(196, 220, 255, 0.56) 42%, rgba(174, 205, 255, 0.38) 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  border-radius: 52rpx;
  box-shadow: 0 46rpx 120rpx rgba(35, 62, 142, 0.24);
  backdrop-filter: blur(42rpx);
  overflow: hidden;
}

.hero-sheen {
  position: absolute;
  inset: 0;
  border-radius: 52rpx;
  background:
    radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.55), transparent 58%),
    radial-gradient(circle at 82% 88%, rgba(113, 178, 255, 0.45), transparent 60%);
  pointer-events: none;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 14rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.2);
  pointer-events: none;
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  flex: 1 1 auto;
  min-width: 0;
}

.hero-text { width: 100%; }

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-brand-block {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(6rpx);
  white-space: nowrap;
}

.brand-main { font-size: 28rpx; font-weight: 700; color: #0b1220; }

.brand-split {
  width: 38rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #2563eb 0%, #0ea5e9 40%, #f472b6 100%);
}

.brand-author {
  font-size: 20rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #2563eb 0%, #9333ea 60%, #f472b6 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
  width: 100%;
}

.hero-textual {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
}

.hero-title { font-size: 44rpx; font-weight: 800; color: #0b1220; line-height: 1.2; }

.app-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #0b1220;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.app-title.one-line {
  width: 100%;
  max-width: 100%;
  font-size: 44rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hero-subtitle {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* force two lines for EN text */
  overflow: hidden;
  word-break: break-word;
  width: 100%;
  max-width: 100%;
}

/* Inserted new rules after .timeline-subtitle */
.chip-btn {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1e3a8a;
  background: rgba(219, 234, 254, 0.85);
  box-shadow: inset 0 0 0 1rpx rgba(96, 165, 250, 0.35);
}

.timeline-scroll { width: 100%; overflow: hidden; }

.hero-icon-wrap {
  position: relative; /* 非绝对定位，位于右列 */
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  flex: 0 0 140rpx; /* 固定列宽 */
  margin-left: auto;
  align-self: flex-start;
  margin-top: 8rpx;
  margin-right: 0;
  border-radius: 44rpx;
  background: linear-gradient(142deg, rgba(255, 255, 255, 0.75) 0%, rgba(202, 225, 255, 0.55) 45%, rgba(148, 180, 255, 0.35) 100%);
  box-shadow: 0 32rpx 84rpx rgba(23, 54, 116, 0.22);
  backdrop-filter: blur(28rpx) saturate(150%);
  overflow: hidden;
}

.hero-glow {
  position: absolute;
  z-index: 0;
  width: 190rpx;
  height: 190rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0));
  filter: blur(12rpx);
  opacity: 0.7;
}

.hero-icon { position: relative; z-index: 1; width: 118rpx; height: 118rpx; }

/* ==========================================================================
   Card Base
   ========================================================================== */
.card {
  box-sizing: border-box;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
}

.card + .card { margin-top: 12rpx; }

.section-title { font-size: 34rpx; font-weight: 600; color: #0f172a; }
.section-desc  { font-size: 24rpx; color: #64748b; line-height: 1.6; }

/* ==========================================================================
   Inputs
   ========================================================================== */
.input,
.picker-display {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  color: #0f172a;
  background: #f8fbff;
  border: 1rpx solid #cbd5f5;
  border-radius: 20rpx;
}

.picker { width: 100%; }

.input-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 44rpx 44rpx 48rpx;
  background: linear-gradient(180deg, rgba(248, 252, 255, 0.95) 0%, rgba(224, 237, 255, 0.9) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  overflow: hidden;
}

.input-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.3);
  pointer-events: none;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.input-title-stack { display: flex; align-items: center; gap: 18rpx; }
.input-pill {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.16);
}

.input-title-text { margin-bottom: 0; }

.input-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.24);
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #9333ea);
}

.badge-text { font-weight: 600; color: #1e293b; }

.input-desc { margin-top: -12rpx; color: #5b6475; }

.input-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260rpx, 1fr));
  gap: 24rpx;
}

.input-card .field {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 32rpx rgba(15, 23, 42, 0.06);
}

.field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.field-name { font-size: 28rpx; font-weight: 600; color: #0f172a; }
.field-hint { font-size: 22rpx; color: #94a3b8; }
.field-hint.optional { color: #f97316; font-weight: 600; }

.field-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 88rpx;
  padding: 0 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.input-card .field-control .input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0;
  font-size: 30rpx;
  color: #0f172a;
}

.field-unit {
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.input-card .picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.picker { width: 100%; }
.picker-value-text { font-size: 30rpx; color: #0f172a; }

.picker-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #64748b;
}

.input-actions { display: flex; flex-direction: column; gap: 18rpx; }

.primary-btn {
  width: 100%;
  margin-top: 12rpx;
  padding: 26rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #6366f1, #4338ca);
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(99, 102, 241, 0.35);
}

.input-actions .primary-btn { margin-top: 0; }

.form-hint { font-size: 22rpx; color: #6c7a92; }

/* ==========================================================================
   Cards (Results)
   ========================================================================== */
.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-header .section-desc { max-width: 480rpx; }

.overlap-card { background: linear-gradient(180deg, #fff7ed 0%, #ffffff 70%); }
.metric-card  { background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, #f8fafc 100%); }

/* Timeline */
.timeline-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  background: linear-gradient(180deg, rgba(248, 251, 255, 0.96) 0%, #ffffff 100%);
}

.timeline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.timeline-title { display: flex; flex-direction: column; gap: 6rpx; }
.timeline-subtitle { font-size: 22rpx; color: #64748b; line-height: 1.4; }

.timeline-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1e3a8a;
  background: rgba(219, 234, 254, 0.85);
  box-shadow: inset 0 0 0 1rpx rgba(96, 165, 250, 0.35);
}

.timeline-rates { display: flex; flex-wrap: wrap; gap: 16rpx; }

.rate-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 160rpx;
  padding: 14rpx 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 22rpx;
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.24);
}

.rate-card.tone-min { background: rgba(191, 219, 254, 0.32); }
.rate-card.tone-max { background: rgba(199, 210, 254, 0.32); }
.rate-card.tone-avg { background: rgba(165, 243, 252, 0.32); }

.rate-label { font-size: 22rpx; color: #475569; }
.rate-value { font-size: 28rpx; font-weight: 600; color: #0f172a; }

.timeline-legend { display: flex; flex-wrap: wrap; gap: 18rpx; }

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 22rpx;
  box-shadow: inset 0 0 0 1rpx rgba(203, 213, 225, 0.45);
}

.legend-swatch { width: 18rpx; height: 18rpx; border-radius: 6rpx; }
.phase-ivct { background: #2563eb; }
.phase-lvet { background: #059669; }
.phase-ivrt { background: #7c3aed; }
.phase-overlap { background: linear-gradient(180deg, #fbbf24 0%, #f97316 100%); }

.timeline-chart {
  padding: 16rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(248, 250, 255, 0.96) 0%, rgba(224, 231, 255, 0.92) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.45);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.25);
  min-width: 720rpx;
}

.timeline-canvas { width: 100%; display: block; }

.timeline-overlap-cards { display: flex; flex-wrap: wrap; gap: 16rpx; }

.overlap-card-item {
  flex: 1;
  min-width: 220rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.overlap-name  { font-size: 22rpx; color: #475569; }
.overlap-detail{ font-size: 24rpx; font-weight: 600; color: #0f172a; }

.timeline-note { font-size: 22rpx; color: #6b7280; line-height: 1.5; }

/* ==========================================================================
   Key-Value List
   ========================================================================== */
.soft-pill { padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 600; }

.kv-list { margin-top: 12rpx; display: flex; flex-direction: column; }

.kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  font-size: 26rpx;
  color: #475569;
  border-bottom: 1rpx solid #e2e8f0;
}

.kv-row:last-child { border-bottom: none; }

.kv-label { max-width: 70%; }
.kv-value { color: #0f172a; font-weight: 600; }

.metric-card .kv-row:last-child { padding-bottom: 0; }

/* ==========================================================================
   Glossary
   ========================================================================== */
.glossary-card { display: flex; flex-direction: column; gap: 20rpx; }

.glossary-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.glossary-row:first-child { border-top: none; }

.glossary-term { font-size: 28rpx; font-weight: 600; color: #1d4ed8; }
.glossary-desc  { font-size: 24rpx; color: #475569; line-height: 1.6; }

/* Glossary header toggle */
.glossary-header { display: flex; align-items: center; justify-content: space-between; }
.glossary-toggle { font-size: 26rpx; color: #2563eb; }