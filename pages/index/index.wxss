page {
  background: linear-gradient(180deg, #dbeafe 0%, #f1f5f9 45%, #f8fafc 100%);
  min-height: 100vh;
}

.page {
  padding: 48rpx 36rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.hero-card {
  position: relative;
  background: linear-gradient(135deg, rgba(237, 245, 255, 0.86) 0%, rgba(196, 220, 255, 0.56) 42%, rgba(174, 205, 255, 0.38) 100%);
  border-radius: 52rpx;
  padding: 36rpx 44rpx 40rpx;
  color: #0f172a;
  border: 1rpx solid rgba(148, 163, 184, 0.28);
  box-shadow: 0 46rpx 120rpx rgba(35, 62, 142, 0.24);
  backdrop-filter: blur(42rpx);
  overflow: hidden;
}

.hero-sheen {
  position: absolute;
  inset: 0;
  border-radius: 52rpx;
  background: radial-gradient(circle at 18% 12%, rgba(255, 255, 255, 0.55), transparent 58%),
    radial-gradient(circle at 82% 88%, rgba(113, 178, 255, 0.45), transparent 60%);
  pointer-events: none;
}

.hero-card::before {
  content: '';
  position: absolute;
  inset: 14rpx;
  border-radius: 44rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.35);
  pointer-events: none;
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-brand-block {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.75);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(6rpx);
  white-space: nowrap;
}

.brand-main {
  font-size: 32rpx;
  font-weight: 700;
  color: #0b1220;
}

.brand-split {
  width: 38rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #2563eb 0%, #0ea5e9 40%, #f472b6 100%);
}

.brand-author {
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(90deg, #2563eb 0%, #9333ea 60%, #f472b6 100%);
  -webkit-background-clip: text;
  color: transparent;
}

.hero-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40rpx;
}

.hero-textual {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hero-title {
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.28;
  color: #0b1220;
  text-shadow: 0 16rpx 30rpx rgba(11, 22, 50, 0.24);
}

.hero-subtitle {
  font-size: 24rpx;
  color: rgba(15, 23, 42, 0.7);
  line-height: 1.7;
  max-width: 560rpx;
}

.hero-icon-wrap {
  flex-shrink: 0;
  width: 140rpx;
  height: 140rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-glow {
  position: absolute;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
  filter: blur(6rpx);
  opacity: 0.85;
  z-index: 0;
}

.hero-icon {
  width: 140rpx;
  height: 140rpx;
  position: relative;
  z-index: 1;
}

.card {
  background: #ffffff;
  border-radius: 36rpx;
  box-shadow: 0 20rpx 50rpx rgba(15, 23, 42, 0.08);
  padding: 36rpx;
  box-sizing: border-box;
}

.card + .card {
  margin-top: 12rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0f172a;
}

.section-desc {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.6;
}

.input,
.picker-display {
  width: 100%;
  border: 1rpx solid #cbd5f5;
  border-radius: 20rpx;
  padding: 20rpx 26rpx;
  font-size: 30rpx;
  color: #0f172a;
  box-sizing: border-box;
  background: #f8fbff;
}

.picker {
  width: 100%;
}

.input-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 44rpx 44rpx 48rpx;
  background: linear-gradient(180deg, rgba(248, 252, 255, 0.95) 0%, rgba(224, 237, 255, 0.9) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  overflow: hidden;
}

.input-card::before {
  content: '';
  position: absolute;
  inset: 12rpx;
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.3);
  pointer-events: none;
}

.input-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.input-title-stack {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.input-pill {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 99, 235, 0.12);
  color: #2563eb;
  box-shadow: inset 0 0 0 1rpx rgba(37, 99, 235, 0.16);
}

.input-title-text {
  margin-bottom: 0;
}

.input-badge {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.24);
  color: #475569;
  font-size: 22rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #9333ea);
}

.badge-text {
  font-weight: 600;
  color: #1e293b;
}

.input-desc {
  margin-top: -12rpx;
  color: #5b6475;
}

.input-grid {
  display: grid;
  gap: 24rpx;
  grid-template-columns: repeat(auto-fit, minmax(260rpx, 1fr));
}

.input-card .field {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  box-shadow: 0 18rpx 32rpx rgba(15, 23, 42, 0.06);
}

.field-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}

.field-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.field-hint {
  font-size: 22rpx;
  color: #94a3b8;
}

.field-hint.optional {
  color: #f97316;
  font-weight: 600;
}

.field-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 22rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.input-card .field-control .input {
  flex: 1;
  border: none;
  padding: 0;
  background: transparent;
  font-size: 30rpx;
  color: #0f172a;
}

.field-unit {
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
}

.input-card .picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(203, 213, 225, 0.7);
  background: #ffffff;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.45), 0 14rpx 26rpx rgba(15, 23, 42, 0.08);
}

.picker-value-text {
  font-size: 30rpx;
  color: #0f172a;
}

.picker-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #64748b;
}

.input-actions {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.primary-btn {
  margin-top: 12rpx;
  background: linear-gradient(135deg, #6366f1, #4338ca);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  padding: 26rpx 0;
  border-radius: 24rpx;
  box-shadow: 0 18rpx 40rpx rgba(99, 102, 241, 0.35);
}

.input-actions .primary-btn {
  margin-top: 0;
  width: 100%;
}

.form-hint {
  font-size: 22rpx;
  color: #6c7a92;
}

.card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-header .section-desc {
  max-width: 480rpx;
}

.overlap-card {
  background: linear-gradient(180deg, #fff7ed 0%, #ffffff 70%);
}

.metric-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, #f8fafc 100%);
}

.timeline-card {
  background: linear-gradient(180deg, rgba(248, 251, 255, 0.96) 0%, #ffffff 100%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.timeline-title {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.timeline-subtitle {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.timeline-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #1e3a8a;
  background: rgba(219, 234, 254, 0.85);
  box-shadow: inset 0 0 0 1rpx rgba(96, 165, 250, 0.35);
}

.timeline-rates {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.rate-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 22rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: inset 0 0 0 1rpx rgba(148, 163, 184, 0.24);
  min-width: 160rpx;
}

.rate-card.tone-min { background: rgba(191, 219, 254, 0.32); }
.rate-card.tone-max { background: rgba(199, 210, 254, 0.32); }
.rate-card.tone-avg { background: rgba(165, 243, 252, 0.32); }

.rate-label {
  font-size: 22rpx;
  color: #475569;
}

.rate-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.timeline-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: inset 0 0 0 1rpx rgba(203, 213, 225, 0.45);
  font-size: 22rpx;
  color: #475569;
}

.legend-swatch {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
}

.phase-ivct { background: #2563eb; }
.phase-lvet { background: #059669; }
.phase-ivrt { background: #7c3aed; }
.phase-overlap { background: linear-gradient(180deg, #fbbf24 0%, #f97316 100%); }

.timeline-chart {
  padding: 16rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, rgba(248, 250, 255, 0.96) 0%, rgba(224, 231, 255, 0.92) 100%);
  border: 1rpx solid rgba(191, 219, 254, 0.45);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.25);
}

.timeline-canvas {
  width: 100%;
  display: block;
}

.timeline-overlap-cards {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.overlap-card-item {
  flex: 1;
  min-width: 220rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(191, 219, 254, 0.55);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.overlap-name {
  font-size: 22rpx;
  color: #475569;
}

.overlap-detail {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.timeline-note {
  font-size: 22rpx;
  color: #6b7280;
  line-height: 1.5;
}

.soft-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.kv-list {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
}

.kv-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #475569;
}

.kv-row:last-child {
  border-bottom: none;
}

.kv-label {
  max-width: 70%;
}

.kv-value {
  color: #0f172a;
  font-weight: 600;
}

.metric-card .kv-row:last-child {
  padding-bottom: 0;
}

.glossary-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.glossary-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #e2e8f0;
}

.glossary-row:first-child {
  border-top: none;
}

.glossary-term {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d4ed8;
}

.glossary-desc {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}
